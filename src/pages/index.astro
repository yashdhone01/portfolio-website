---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import { projects } from "../data/projects.js";
import ProjectCard from "../components/ProjectCard.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import Testimonials from "../components/Testimonials.astro";
import SEO from "../components/SEO.astro"; 
---

<html lang="en">
  <head>
    <SEO 
      title="Yash Dhone | AI & Cybersecurity Engineer"
      description="Portfolio of Yash Dhone - Game Developer, AI Engineer, and Cybersecurity Analyst specializing in immersive web experiences and data-driven systems."
      image="/pfp.jpg"
    />

    <!-- GOOGLE SEARCH CONSOLE VERIFICATION -->
    <meta name="google-site-verification" content="bxh7SWzpOSkSDDQFpImWfSxTG2a5_lNUJu1lVSBq_6o" />
    
    <style>
      /* --- FIX 1: HERO FULL SCREEN --- */
      .hero {
        min-height: 100vh !important;
        display: flex;
        align-items: center;
      }

      /* --- RESPONSIVE TEXT & CONTAINER --- */
      .hero-content {
        max-width: 100% !important; 
        flex: 1; 
        min-width: 0; 
        z-index: 10;
      }

      .hero h1 {
        font-size: clamp(2.5rem, 5vw, 4.5rem) !important;
        white-space: nowrap;
      }

      #typing-name {
        min-width: auto !important;
        white-space: nowrap !important;
      }
      
      :global(.gradient-text) {
        display: inline-block; 
        white-space: nowrap;
      }

      /* --- SPEECH BUBBLE (CLOUD STYLE) --- */
      .speech-bubble {
        position: absolute;
        background: #ffffff;
        color: #000;
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 700;
        font-family: 'Courier New', monospace;
        font-size: 1rem;
        pointer-events: none; 
        opacity: 0; 
        transition: opacity 0.5s ease;
        transform: translate(0, -100%); 
        z-index: 20;
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        white-space: nowrap;
        min-width: 120px;
        text-align: center;
      }
      
      .speech-bubble::before {
        content: '';
        position: absolute;
        bottom: 2px;
        left: -8px;
        width: 16px;
        height: 16px;
        background: #ffffff;
        border-radius: 50%;
      }
      
      .speech-bubble::after {
        content: '';
        position: absolute;
        bottom: -6px;
        left: -16px;
        width: 12px;
        height: 12px;
        background: #ffffff;
        border-radius: 50%;
      }

      /* --- NEW: SKILL PILLS & SPACING --- */
      .marquee {
        height: 60px !important;
      }

      .skills-section {
        padding-bottom: 20px !important;
        margin-bottom: 0 !important;
      }
      #about {
        padding-top: 40px !important;
        margin-top: 0 !important;
      }

      .skill-pill {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 8px 20px;
        border-radius: 100px;
        transition: all 0.3s ease;
      }

      .skill-pill:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: #00eaff;
        transform: translateY(-2px);
      }

      .skill-pill img {
        height: 24px !important; 
        width: auto !important;
        filter: none !important; 
      }

      .skill-pill span {
        font-size: 0.95rem;
        font-weight: 500;
        color: #e0e0e0;
        white-space: nowrap;
      }

      /* --- PROJECTS GRID VARIANTS --- */
      @media (min-width: 768px) {
        .wide-card {
          grid-column: span 2;
        }
      }

      @media (max-width: 900px) {
        .hero {
          flex-direction: column-reverse;
          text-align: center;
          padding-top: 100px;
        }
        .hero-content {
          text-align: center;
          width: 100%;
        }
        .hero-buttons {
          justify-content: center;
        }
        .hero-visual {
          width: 100% !important;
          height: 350px !important;
          margin-bottom: 20px;
        }
      }
    </style>
  </head>

