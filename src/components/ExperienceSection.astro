<section id="experience" class="experience-section reveal">
  <!-- HEADING -->
  <h2>Professional <span class="gradient-text">Experience</span> & <span class="gradient-text">Achievements</span></h2>
  
  <!-- CARD 1: INTERNSHIP (FIREBIRD VR) -->
  <div class="experience-card">
    <div class="visual-side">
      <!-- REVERTED TO THREE.JS CANVAS -->
      <canvas id="game-canvas"></canvas>
      <div class="visual-overlay">Interactive 3D Preview</div>
    </div>

    <div class="content-side">
      <div class="header">
        <div class="logo-container">
           <img src="/logos/firebird.png" alt="Firebird VR" class="company-logo" />
        </div>
        <div class="header-text">
          <h3 class="role">Game Developer Intern</h3>
          <div class="company">FIREBIRD VR PVT LTD. <span class="location">| Pune, India</span></div>
        </div>
      </div>
      
      <ul class="job-details">
        <li>Developed XR/VR prototypes in Unity, integrating interactive features and immersive user experiences.</li>
        <li>Wrote and optimized C# scripts for gameplay mechanics, input handling, and real-time interactions.</li>
        <li>Enhanced performance and rendering pipelines to ensure smooth cross-device VR functionality.</li>
        <li>Prepared concept documents and technical documentation for new features, improving project clarity.</li>
        <li>Collaborated in an Agile environment (scrum, sprints) to deliver iterations on time with cross-functional teams.</li>
      </ul>
    </div>
  </div>

  <!-- CARD 2: HACKATHON WIN (SLEEP APNEA) -->
  <div class="experience-card" style="margin-top: 40px;">
    <div class="visual-side">
      <canvas id="hackathon-canvas"></canvas>
      <div class="visual-overlay">Live Data Visualization</div>
    </div>

    <div class="content-side">
      <div class="header">
        <div class="logo-container icon-bg">
           <span style="font-size: 28px;">🏆</span>
        </div>
        
        <div class="header-text">
          <h3 class="role">Team Lead & 1st Prize Winner</h3>
          <div class="company">Vishwacon 2024 (Springer Nature) <span class="location">| AI in Healthcare</span></div>
        </div>
      </div>
      
      <ul class="job-details">
        <li>Led the team to win <strong>1st Prize</strong> at the AI in Healthcare Product Conclave for a Sleep Apnea Detection system.</li>
        <li>Architected a real-time monitoring solution using ESP32 & MAX30102 to track SpO2 and heart rate patterns.</li>
        <li>Developed intelligent algorithms to identify potential apnea events and trigger alerts for critical anomalies.</li>
        <li>Built a cloud-integrated dashboard using Firebase to visualize patient vitals securely and remotely.</li>
      </ul>
    </div>
  </div>

  <!-- CARD 3: RESEARCH PAPER -->
  <div class="experience-card" style="margin-top: 40px;">
    
    <!-- LEFT: 3D NETWORK VISUALIZATION -->
    <div class="visual-side">
      <canvas id="research-canvas"></canvas>
      <div class="visual-overlay">Network Analysis Model</div>
    </div>

    <div class="content-side">
      <div class="header">
        <!-- Scroll/Paper Icon -->
        <div class="logo-container" style="background: rgba(255, 215, 0, 0.1); border: 1px solid rgba(255, 215, 0, 0.3);">
           <span style="font-size: 24px;">📜</span>
        </div>
        
        <div class="header-text">
          <h3 class="role">Research Author & Presenter</h3>
          <div class="company">IJEEDC Journal & IRCSTEM Conf. <span class="location">| Data Science</span></div>
        </div>
      </div>
      
      <ul class="job-details">
        <li>Authored and published <strong>"A Comparative Framework for Analyzing Runway Availability"</strong> in the IJEEDC Journal.</li>
        <li>Presented research findings at the IRCSTEM Conference, demonstrating analytical rigor and public speaking skills.</li>
        <li>Utilized advanced data analysis frameworks to model and optimize runway usage efficiency.</li>
        <li>Contributed to the field of aviation logistics through data-driven comparative studies.</li>
      </ul>
    </div>

  </div>

</section>

<style>
  .experience-section {
    padding: 100px 20px;
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .experience-section h2 {
    font-size: 2.8rem;
    font-weight: 800;
    margin-bottom: 60px;
    color: #ffffff;
  }

  .gradient-text {
    background: linear-gradient(to right, #00eaff, #a369ff);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .experience-card {
    display: grid;
    grid-template-columns: 380px 1fr; 
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
    overflow: hidden;
    transition: all 0.4s ease;
    text-align: left;
    position: relative;
    min-height: 350px;
  }

  .experience-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 234, 255, 0.3);
    box-shadow: 0 0 30px rgba(0, 234, 255, 0.1), inset 0 0 20px rgba(0, 234, 255, 0.05);
  }

  .visual-side {
    position: relative;
    background: linear-gradient(135deg, #0a0f16, #000);
    height: 100%; 
    width: 100%;
    overflow: hidden;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
  }

  canvas {
    width: 100%;
    height: 100%;
    cursor: grab;
    display: block; 
  }
  canvas:active { cursor: grabbing; }

  .visual-overlay {
    position: absolute;
    bottom: 20px;
    left: 20px;
    font-size: 0.75rem;
    background: rgba(0,0,0,0.6);
    padding: 6px 12px;
    border-radius: 20px;
    color: rgba(255, 255, 255, 0.8);
    text-transform: uppercase;
    letter-spacing: 1px;
    pointer-events: none;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .content-side {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
  }

  .logo-container {
    width: 60px;
    height: 60px;
    min-width: 60px; 
    background: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }
  
  .icon-bg {
    background: linear-gradient(135deg, #FFD700 0%, #B8860B 100%);
    border: 1px solid #FFD700;
  }

  .company-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .role {
    font-size: 1.6rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 4px;
  }

  .company {
    font-size: 1rem;
    color: #00eaff;
    font-weight: 600;
  }

  .location {
    color: #888;
    font-weight: 400;
  }

  .job-details {
    list-style: none;
    padding: 0;
  }

  .job-details li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 12px;
    font-size: 1rem;
    color: #c0c0c0;
    line-height: 1.6;
  }

  .job-details li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: #a369ff;
  }
  
  .job-details li strong {
    color: #FFD700;
  }

  @media (max-width: 800px) { 
    .experience-card {
      grid-template-columns: 1fr;
    }
    .visual-side {
      height: 300px; /* Taller on mobile for game visibility */
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .content-side {
      padding: 30px 20px;
    }
  }
</style>

<script type="module">
  import * as THREE from "https://cdn.skypack.dev/three@0.136.0";

  // --- SCENE 1: GAME PREVIEW (RESTORED THREE.JS) ---
  (function initGamePreview() {
    const canvas = document.getElementById("game-canvas");
    if (!canvas) return;

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x0a0f16, 0.05);

    const camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / canvas.clientHeight, 0.1, 1000);
    camera.position.set(0, 2, 6);

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.setPixelRatio(window.devicePixelRatio);

    // Neon Grid Floor
    const gridHelper = new THREE.GridHelper(40, 40, 0xa369ff, 0x00eaff);
    gridHelper.position.y = -2;
    scene.add(gridHelper);

    const group = new THREE.Group();
    scene.add(group);

    // Floating Geometries (Representing Game Objects)
    const geo1 = new THREE.IcosahedronGeometry(1.5, 0);
    const mat1 = new THREE.MeshStandardMaterial({ 
      color: 0x00eaff, 
      wireframe: true,
      emissive: 0x00eaff,
      emissiveIntensity: 0.5
    });
    const mesh1 = new THREE.Mesh(geo1, mat1);
    group.add(mesh1);

    const geo2 = new THREE.TorusGeometry(2.5, 0.1, 8, 50);
    const mat2 = new THREE.MeshBasicMaterial({ color: 0xa369ff });
    const mesh2 = new THREE.Mesh(geo2, mat2);
    mesh2.rotation.x = Math.PI / 2;
    group.add(mesh2);

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
    scene.add(ambientLight);
    const pointLight = new THREE.PointLight(0x00eaff, 2, 20);
    pointLight.position.set(5, 5, 5);
    scene.add(pointLight);

    // Visibility Check
    let isVisible = false;
    const observer = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
    }, { threshold: 0.1 });
    observer.observe(canvas);

    let isDragging = false;
    let previousMousePosition = { x: 0, y: 0 };
    let rotationVelocity = { x: 0.002, y: 0.002 };

    function animate() {
      requestAnimationFrame(animate);
      if (!isVisible) return;

      mesh1.rotation.y += 0.01;
      mesh1.rotation.x += 0.005;
      mesh2.rotation.z -= 0.005;
      group.rotation.y += rotationVelocity.x;
      group.rotation.x += rotationVelocity.y;

      if (!isDragging) {
        rotationVelocity.x = THREE.MathUtils.lerp(rotationVelocity.x, 0.002, 0.05);
        rotationVelocity.y = THREE.MathUtils.lerp(rotationVelocity.y, 0.002, 0.05);
      }
      renderer.render(scene, camera);
    }
    animate();

    // Interaction
    canvas.addEventListener("mousedown", (e) => {
      isDragging = true;
      previousMousePosition = { x: e.offsetX, y: e.offsetY };
    });
    window.addEventListener("mousemove", (e) => {
      if (isDragging) {
        const deltaMove = {
          x: e.offsetX - previousMousePosition.x,
          y: e.offsetY - previousMousePosition.y,
        };
        rotationVelocity.x = deltaMove.x * 0.005;
        rotationVelocity.y = deltaMove.y * 0.005;
        previousMousePosition = { x: e.offsetX, y: e.offsetY };
      }
    });
    window.addEventListener("mouseup", () => (isDragging = false));

    window.addEventListener("resize", () => {
      if (!document.getElementById("game-canvas")) return;
      const parent = canvas.parentElement;
      renderer.setSize(parent.clientWidth, parent.clientHeight);
      camera.aspect = parent.clientWidth / parent.clientHeight;
      camera.updateProjectionMatrix();
    });
  })();

  // --- SCENE 2: HACKATHON PREVIEW (Medical Wave) ---
  (function initHackathonPreview() {
    const canvas = document.getElementById("hackathon-canvas");
    if (!canvas) return;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a0f16);

    const camera = new THREE.PerspectiveCamera(60, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
    camera.position.set(0, 5, 10);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.setPixelRatio(window.devicePixelRatio);

    const particleCount = 100;
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);
    const colors = new Float32Array(particleCount * 3);
    
    for(let i = 0; i < particleCount; i++) {
        const x = (i / particleCount) * 16 - 8;
        positions[i*3] = x;
        positions[i*3+1] = 0;
        positions[i*3+2] = 0;

        const color = new THREE.Color();
        color.setHSL(0.5 + (i/particleCount) * 0.5, 1.0, 0.5); 
        colors[i*3] = color.r;
        colors[i*3+1] = color.g;
        colors[i*3+2] = color.b;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const material = new THREE.PointsMaterial({
        size: 0.4,
        vertexColors: true,
        transparent: true,
        opacity: 0.9
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    const lineMat = new THREE.LineBasicMaterial({ color: 0x00eaff, opacity: 0.3, transparent: true });
    const line = new THREE.Line(geometry, lineMat);
    scene.add(line);

    // Visibility Check
    let isVisible = false;
    const observer = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
    }, { threshold: 0.1 });
    observer.observe(canvas);

    function animate() {
      requestAnimationFrame(animate);
      if (!isVisible) return;
      
      const time = Date.now() * 0.002;
      const positions = particles.geometry.attributes.position.array;

      for(let i = 0; i < particleCount; i++) {
          const x = positions[i*3];
          let y = Math.sin(x + time) * 1.5; 
          const pulseX = (time * 5) % 20 - 10;
          const dist = Math.abs(x - pulseX);
          if(dist < 1.5) {
              y += Math.sin((1.5 - dist) * Math.PI) * 3;
          }
          positions[i*3+1] = y;
      }
      
      particles.geometry.attributes.position.needsUpdate = true;
      particles.rotation.y += 0.002;
      line.rotation.y += 0.002;

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener("resize", () => {
      if (!document.getElementById("hackathon-canvas")) return;
      const parent = canvas.parentElement;
      renderer.setSize(parent.clientWidth, parent.clientHeight);
      camera.aspect = parent.clientWidth / parent.clientHeight;
      camera.updateProjectionMatrix();
    });
  })();

  // --- SCENE 3: RESEARCH PAPER (Plexus Network) ---
  (function initResearchPreview() {
    const canvas = document.getElementById("research-canvas");
    if (!canvas) return;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a0f16);

    const camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
    camera.position.z = 15;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.setPixelRatio(window.devicePixelRatio);

    // Create random nodes
    const nodeCount = 40;
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(nodeCount * 3);
    const velocities = [];

    for (let i = 0; i < nodeCount; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 20;
      positions[i * 3 + 1] = (Math.random() - 0.5) * 20;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 10;
      velocities.push({
        x: (Math.random() - 0.5) * 0.05,
        y: (Math.random() - 0.5) * 0.05,
        z: (Math.random() - 0.5) * 0.05
      });
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const material = new THREE.PointsMaterial({ color: 0xFFD700, size: 0.3 }); // Gold nodes
    const nodes = new THREE.Points(geometry, material);
    scene.add(nodes);

    // Lines to connect near nodes
    const lineMaterial = new THREE.LineBasicMaterial({ color: 0x00eaff, transparent: true, opacity: 0.4 });
    const linesGeometry = new THREE.BufferGeometry();
    const lines = new THREE.LineSegments(linesGeometry, lineMaterial);
    scene.add(lines);

    // Visibility Check
    let isVisible = false;
    const observer = new IntersectionObserver((entries) => {
      isVisible = entries[0].isIntersecting;
    }, { threshold: 0.1 });
    observer.observe(canvas);

    function animate() {
      requestAnimationFrame(animate);
      if (!isVisible) return;

      const positions = nodes.geometry.attributes.position.array;
      
      // Move nodes
      for (let i = 0; i < nodeCount; i++) {
        positions[i * 3] += velocities[i].x;
        positions[i * 3 + 1] += velocities[i].y;
        positions[i * 3 + 2] += velocities[i].z;

        // Bounce off bounds
        if (Math.abs(positions[i * 3]) > 10) velocities[i].x *= -1;
        if (Math.abs(positions[i * 3 + 1]) > 10) velocities[i].y *= -1;
        if (Math.abs(positions[i * 3 + 2]) > 5) velocities[i].z *= -1;
      }
      nodes.geometry.attributes.position.needsUpdate = true;

      // Draw lines between close nodes
      const linePositions = [];
      for (let i = 0; i < nodeCount; i++) {
        for (let j = i + 1; j < nodeCount; j++) {
          const dx = positions[i * 3] - positions[j * 3];
          const dy = positions[i * 3 + 1] - positions[j * 3 + 1];
          const dz = positions[i * 3 + 2] - positions[j * 3 + 2];
          const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

          if (dist < 6) {
            linePositions.push(
              positions[i * 3], positions[i * 3 + 1], positions[i * 3 + 2],
              positions[j * 3], positions[j * 3 + 1], positions[j * 3 + 2]
            );
          }
        }
      }
      lines.geometry.setAttribute('position', new THREE.Float32BufferAttribute(linePositions, 3));

      // Slow rotation
      scene.rotation.y += 0.002;

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener("resize", () => {
      if (!document.getElementById("research-canvas")) return;
      const parent = canvas.parentElement;
      renderer.setSize(parent.clientWidth, parent.clientHeight);
      camera.aspect = parent.clientWidth / parent.clientHeight;
      camera.updateProjectionMatrix();
    });
  })();
</script>