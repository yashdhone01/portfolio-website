<style>
  /* --- NEW BACKGROUND & FULL WIDTH STYLING --- */
  .testimonials-section {
    padding: 100px 0; /* Vertical padding only */
    
    /* FORCE FULL WIDTH BREAKOUT */
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    margin-top: 80px;
    margin-bottom: 80px;
    
    text-align: center;
    
    /* Lightest Theme Background (White + Subtle Blue-Cyan Glow) */
    background: radial-gradient(circle at 50% 50%, #ffffff 0%, #f0f9ff 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .content-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Updated Text Colors for Light BG */
  .testimonials-section h2 {
    font-size: 2.8rem;
    font-weight: 800;
    margin-bottom: 20px;
    color: #111827; /* Dark Text */
  }

  .subtitle {
    color: #64748b; /* Medium Gray */
    margin-bottom: 60px;
    font-size: 1.1rem;
  }

  .gradient-text {
    background: linear-gradient(to right, #00eaff, #a369ff);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  /* --- 3-COLUMN MARQUEE CONTAINER --- */
  .marquee-container {
    position: relative;
    height: 600px; 
    overflow: hidden;
    width: 100%;
    /* Max width container for the cards themselves, centering them */
    max-width: 1400px; 
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3 Columns */
    gap: 24px;
    padding: 0 20px;
    
    /* Updated Masks to match the light background (White/#f0f9ff) */
    mask-image: linear-gradient(to bottom, transparent, white 10%, white 90%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, white 10%, white 90%, transparent);
  }

  /* FADE OVERLAYS (Visual Gradient matching Light BG) */
  .fade-overlay {
    position: absolute;
    left: 0;
    right: 0;
    height: 100px;
    z-index: 2;
    pointer-events: none;
  }
  .fade-overlay.top {
    top: 0;
    background: linear-gradient(to bottom, #f0f9ff, transparent);
  }
  .fade-overlay.bottom {
    bottom: 0;
    background: linear-gradient(to top, #f0f9ff, transparent);
  }

  .marquee-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: 24px; 
  }

  /* Animation Classes */
  .scroll-up {
    animation: marquee-up 50s linear infinite;
  }

  .scroll-down {
    animation: marquee-down 50s linear infinite;
  }

  @keyframes marquee-up {
    0% { transform: translateY(0); }
    100% { transform: translateY(-33.333%); } 
  }

  @keyframes marquee-down {
    0% { transform: translateY(-33.333%); } 
    100% { transform: translateY(0); }
  }

  /* --- CARD STYLES --- */
  .testimonial-card.light-theme {
    background: #ffffff;
    /* Darker/Clearer border for contrast against white BG */
    border: 1px solid #cbd5e1; 
    border-radius: 20px;
    padding: 25px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    /* Stronger shadow for depth */
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    flex-shrink: 0;
  }

  .testimonial-card.light-theme:hover {
    transform: scale(1.02);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    border-color: #00eaff;
    z-index: 10;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .light-theme .quote-icon {
    font-size: 3rem;
    color: #e0e7ff;
    line-height: 1;
    margin-bottom: -15px;
    font-family: serif;
  }

  .light-theme .feedback {
    font-size: 0.95rem;
    color: #334155;
    line-height: 1.5;
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
    font-weight: 500;
  }

  .light-theme .person {
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid #f1f5f9;
    padding-top: 12px;
  }

  .light-theme .avatar {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #00eaff, #a369ff);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: #ffffff;
    font-size: 1.1rem;
  }

  .light-theme .info .name {
    font-weight: 700;
    color: #0f172a;
    font-size: 0.95rem;
    margin-bottom: 2px;
  }

  .light-theme .info .designation {
    font-size: 0.8rem;
    color: #64748b;
  }

  /* Responsive Logic */
  @media (max-width: 1024px) {
    .marquee-container {
      grid-template-columns: 1fr 1fr;
    }
    .marquee-column:nth-child(3) {
      display: none; 
    }
  }

  @media (max-width: 700px) {
    .marquee-container {
      grid-template-columns: 1fr;
      height: auto; 
      overflow: visible;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .fade-overlay { display: none; }
    
    .marquee-column {
      animation: none;
      padding-bottom: 0;
    }
    
    .marquee-column:nth-child(2),
    .marquee-column:nth-child(3) {
      display: none; 
    }
    
    .testimonial-card:nth-child(n+3) {
      display: none;
    }
  }
</style>